<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI 채찍"
            android:textColor="@color/ink"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp"
            android:text="AI가 헛소리하면 폰을 채찍처럼 휘두르세요."
            android:textColor="@color/dim"
            android:textSize="14sp" />

        <!-- 1. 접근성 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1. 접근성 서비스 켜기"
            android:textColor="@color/dim"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/ink"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtGuide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingMultiplier="1.35"
            android:text="먼저 제한을 풉니다\n① 아래 '앱 정보 열기'를 누릅니다.\n② 오른쪽 위 ⋮(점 세 개)를 누릅니다.\n③ '제한된 설정 허용'을 누르고 잠금을 풉니다.\n\n그다음 스위치를 켭니다\n④ 이 화면으로 돌아와 '접근성 설정 열기'를 누릅니다.\n⑤ '설치된 앱'(기기에 따라 '다운로드한 앱')을 누릅니다.\n⑥ 'AI 채찍'을 누릅니다.\n⑦ 맨 위의 '꺼짐' 스위치를 켭니다.\n     'AI 채찍 바로가기'는 켜지 않아도 됩니다.\n⑧ 안내 창에서 '허용'을 누르고 이 화면으로 돌아옵니다.\n\n②에서 ⋮가 보이지 않으면 ④~⑦을 먼저 한 번 합니다. '제한된 설정' 안내가 뜬 뒤에 ⋮가 나타납니다."
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnAppInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="앱 정보 열기 (제한된 설정 허용)" />

        <Button
            android:id="@+id/btnAccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="접근성 설정 열기" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp"
            android:lineSpacingMultiplier="1.3"
            android:text="왜 필요한가: 혼낼 앱이 화면에 떠 있는지 알아내고, 그 위에 채찍을 그리고, 입력창에 문구를 넣는 데 씁니다."
            android:textColor="@color/dim"
            android:textSize="12sp" />

        <!-- 2. 혼낼 앱 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2. 혼낼 앱 고르기"
            android:textColor="@color/dim"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnTarget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="앱 선택" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp"
            android:lineSpacingMultiplier="1.3"
            android:text="고른 앱이 화면에 떠 있을 때만 흔들기를 감지합니다. 다른 앱을 쓰는 동안이나 화면이 꺼져 있을 때는 아무 일도 하지 않습니다."
            android:textColor="@color/dim"
            android:textSize="12sp" />

        <!-- 3. 문구 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3. 보낼 문구와 횟수"
            android:textColor="@color/dim"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/edtMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:textColor="@color/ink"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="몇 번 휘두르면 보낼지"
            android:textColor="@color/dim"
            android:textSize="12sp" />

        <RadioGroup
            android:id="@+id/rgHits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbHit1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="1번"
                android:textColor="@color/ink" />

            <RadioButton
                android:id="@+id/rbHit2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="2번"
                android:textColor="@color/ink" />

            <RadioButton
                android:id="@+id/rbHit3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="3번"
                android:textColor="@color/ink" />

            <RadioButton
                android:id="@+id/rbHit5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="5번"
                android:textColor="@color/ink" />
        </RadioGroup>

        <Switch
            android:id="@+id/swAuto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="전송 버튼까지 자동으로 누르기"
            android:textColor="@color/ink"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp"
            android:lineSpacingMultiplier="1.3"
            android:text="고른 횟수만큼 휘두르면 게이지가 다 차고, 이 문구를 혼낼 앱의 입력창에 넣습니다. 1번으로 하면 한 번 휘두를 때마다 바로 전달됩니다.\n· 켜면: 전송 버튼까지 눌러 실제로 메시지가 갑니다.\n· 끄면: 입력창에 문구만 넣습니다. 전송은 직접 누릅니다.\n· 입력창을 찾지 못하면 문구를 복사해 두니 붙여넣으면 됩니다.\n처음에는 끄고 문구가 잘 들어가는지 먼저 확인하세요."
            android:textColor="@color/dim"
            android:textSize="12sp" />

        <!-- 4. 감도 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4. 흔들기 감도"
            android:textColor="@color/dim"
            android:textSize="12sp" />

        <RadioGroup
            android:id="@+id/rgSens"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbLow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="둔감"
                android:textColor="@color/ink" />

            <RadioButton
                android:id="@+id/rbMid"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="보통"
                android:textColor="@color/ink" />

            <RadioButton
                android:id="@+id/rbHigh"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="민감"
                android:textColor="@color/ink" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp"
            android:lineSpacingMultiplier="1.3"
            android:text="세게 휘둘러도 반응이 없으면 '민감', 살짝 움직여도 채찍이 나오면 '둔감'으로 바꾸세요."
            android:textColor="@color/dim"
            android:textSize="12sp" />

        <!-- 5. 접히는 시간 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5. 채찍이 접히는 시간"
            android:textColor="@color/dim"
            android:textSize="12sp" />

        <RadioGroup
            android:id="@+id/rgIdle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbIdle3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="3초"
                android:textColor="@color/ink" />

            <RadioButton
                android:id="@+id/rbIdle5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="5초"
                android:textColor="@color/ink" />

            <RadioButton
                android:id="@+id/rbIdle10"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="10초"
                android:textColor="@color/ink" />

            <RadioButton
                android:id="@+id/rbIdle30"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="30초"
                android:textColor="@color/ink" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp"
            android:lineSpacingMultiplier="1.3"
            android:text="이 시간 동안 휘두르지 않으면 채찍이 사라지고 화면 오른쪽 위에 작은 아이콘이 남습니다. 아이콘을 누르면 채찍이 돌아옵니다. 휘두를 때마다 시간을 다시 셉니다."
            android:textColor="@color/dim"
            android:textSize="12sp" />

        <!-- 6. 테스트 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="6. 확인하고 쓰기"
            android:textColor="@color/dim"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnTest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="채찍 테스트" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingMultiplier="1.35"
            android:text="테스트 버튼은 이 화면 위에 채찍만 보여 주고 문구는 보내지 않습니다. 채찍과 '짝' 소리가 나오면 준비가 끝난 것입니다.\n\n쓰는 법\n① 혼낼 앱을 엽니다.\n② 폰을 단단히 쥐고 채찍처럼 세게 휘두릅니다.\n③ 화면 위쪽 게이지가 찹니다. 3번에서 고른 횟수만큼 치면 다 찹니다.\n④ 게이지가 다 차면 3번의 문구가 전달됩니다.\n\n한동안 휘두르지 않으면 채찍이 접혀 작은 아이콘이 됩니다. 시간은 5번에서 바꿉니다."
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:lineSpacingMultiplier="1.3"
            android:text="이 앱은 인터넷 권한이 없어 어떤 데이터도 밖으로 보내지 않습니다. 화면 내용은 입력창과 전송 버튼을 찾는 데만 쓰고 저장하지 않습니다. 특정 AI 서비스와 무관한 개인 제작 장난용 앱입니다. 주변 사람과 폰 낙하에 주의하세요."
            android:textColor="@color/dim"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
